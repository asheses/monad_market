# Run all commands from foundry/. Use a test wallet with testnet MON for gas.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Replace with 0x + 64 hex characters; never commit the real .env.
PRIVATE_KEY=

# Fill after DeployTestUSDC succeeds.
USDC_ADDRESS=0x0000000000000000000000000000000000000000
# Fill with proxy addresses after DeployBitmapLink succeeds.
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Nonzero address that may pause/resolve the market. Can be the deployer for tests.
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
# Optional separate oracle key; SetYesWinLink.s.sol falls back to PRIVATE_KEY when empty.
ORACLE_PRIVATE_KEY=
# Integer scale 10000; 100 = 1% coefficient applied to p*(1-p).
TAKER_FEE_RATE=100
# Fraction of taker fee rebated to maker; 5000 = 50%.
MAKER_REBATE_RATE=5000
# Optional: fill after CreateMarket succeeds, for later interaction.
MARKET_ADDRESS=0x0000000000000000000000000000000000000000
# Required for MonadScan source verification (Etherscan API key).
MONAD_EXPLORER_KEY=

# Fill with implementation addresses from the new bitmapLink deployment.
VAULT_IMPLEMENTATION=
FACTORY_IMPLEMENTATION=
MARKET_IMPLEMENTATION=
